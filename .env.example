DATABASE_URL=postgresql://postgres:postgres@localhost:5432/founder_os
BETTER_AUTH_SECRET=replace-with-a-32-character-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Required: replace with the email of your existing owner account.
OWNER_EMAIL=owner@example.com
# Leave unset for existing accounts. See docs/DECISIONS.md for first-owner setup.
# OWNER_SETUP_TOKEN=
# Set to 1 to fail fast locally on missing/invalid required env, the same way Vercel does (ADR-016).
# FOUNDER_OS_STRICT_ENV=
# Set to 1 to use the small pooled-connection Postgres options against a non-Neon-pooled URL (ADR-016).
# DATABASE_POOLED=
